---
import NavbarComponent from "../components/NavbarComponent.astro"
import FooterComponent from "../components/FooterComponent.astro"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="gurukulFavicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Gurukul</title>
	</head>
	<body>
		<div class="root">
			<div class="header">
				<NavbarComponent/>
			</div>

			<slot/>

			<div class="footer">
				<FooterComponent/>
			</div>
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	.root{
		/* border:2px solid red; */
		min-height: 100vh;
		position:relative;
		display: flex;
		flex-direction: column;
	}
	.root .header{
		position: relative;
		top: 0;
	}

	.root .footer{
		margin-top: auto;
	}
</style>
