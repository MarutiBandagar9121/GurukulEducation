---
import FaqComponent from "../components/faqComponent.astro";
import "../styles/globalStyles.css";
import FaqImage from "../assets/faq-lineart.png";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="flex items-center gap-4 ml-5 mt-5 justify-center">
        <div class="h-px w-20 bg-orange-800"></div>
        <span class="font-extrabold text-orange-800 text-2xl italic">FAQ'S</span>
        <div class="h-px w-20 bg-orange-800"></div>
    </div>

    <div class="faq-root w-full">
        <div class="faq-section flex flex-row h-full">
            <div class="right  w-full md:w-2/3 p-5">
                <FaqComponent/>
            </div>
            <div class="left w-1/3 hidden md:flex justify-center items-start p-5 relative">
                <img src={FaqImage.src} class="w-72 sticky top-0" alt="">
            </div>
        </div>
    </div>
</Layout>
