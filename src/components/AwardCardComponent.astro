---
const { title, desc } = Astro.props;
import AwardSvg from "../assets/Award.svg"
---

<div class="max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow w-64 py-10 mb-2">
    <img src={AwardSvg.src} class="w-10" alt="">
    <a href="#">
        <h5 class="mb-2 text-xl font-semibold tracking-tight text-gray-900 ">{title}</h5>
    </a>
    <p class="mb-3 font-normal text-gray-500 ">{desc}</p>
</div>
