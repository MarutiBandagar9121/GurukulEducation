---
import Male from "../assets/male.png"
import Female from "../assets/female.png"
import ManojNaidu from "../assets/manojNaidu.jpg"
import GayatriNaidu from "../assets/gayatriNaidu.jpg"
---
<div class="bg-white py-24 sm:py-32">
    <div class="mx-auto grid max-w-7xl gap-20 px-6 lg:px-8 xl:grid-cols-3">
      <div class="max-w-xl">
        <h2 class="text-pretty text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Meet our leadership</h2>
        <p class="mt-6 text-lg/8 text-gray-600">We’re a dynamic group of individuals who are passionate about what we do and dedicated to delivering the best results for our clients.</p>
      </div>
      <ul role="list" class="grid gap-x-8 gap-y-12 sm:grid-cols-2 sm:gap-y-16 xl:col-span-2">
        <li>
          <div class="flex items-center gap-x-6">
            <img class="size-40 rounded-full" src={ManojNaidu.src} alt="">
            <div>
              <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Ex Commando Manoj Naidu</h3>
              <p class="text-sm/6 font-semibold text-indigo-600">Chairman</p>
            </div>
          </div>
        </li>

        <li>
            <div class="flex items-center gap-x-6">
              <img class="size-40 rounded-full" src={GayatriNaidu.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Gayatri Naidu</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">Managing Director</p>
              </div>
            </div>
          </li>

          <li>
            <div class="flex items-center gap-x-6">
              <img class="size-16 rounded-full" src={Female.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Archana Naidu</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">Legal Advisor (Press Reporter)</p>
              </div>
            </div>
          </li>

          <li>
            <div class="flex items-center gap-x-6">
              <img class="size-16 rounded-full" src={Male.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">ADV.(Gov) Abhijit Vishwanath Sakurkar</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">Legal Advisor</p>
              </div>
            </div>
          </li>

          <li>
            <div class="flex items-center gap-x-6">
              <img class="size-16 rounded-full" src={Male.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Amar Ashok Sonawne</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">Training Officer, Adventure Head</p>
              </div>
            </div>
          </li>

          <li>
            <div class="flex items-center gap-x-6">
              <img class="size-16 rounded-full" src={Male.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Mukesh sahani</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">Command Instructor</p>
              </div>
            </div>
          </li>

          <li>
            <div class="flex items-center gap-x-6">
              <img class="size-16 rounded-full" src={Male.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Shravan Mahadik</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">Adventure Instructor</p>
              </div>
            </div>
          </li>

          <li>
            <div class="flex items-center gap-x-6">
              <img class="size-16 rounded-full" src={Female.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Shruti Kulkarni</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">Girl's Instructor Head</p>
              </div>
            </div>
          </li>

          <li>
            <div class="flex items-center gap-x-6">
              <img class="size-16 rounded-full" src={Female.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Anaya Marry Sebastian</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">Girl's Instructor</p>
              </div>
            </div>
          </li>

          <li>
            <div class="flex items-center gap-x-6">
              <img class="size-16 rounded-full" src={Female.src} alt="">
              <div>
                <h3 class="text-base/7 font-semibold tracking-tight text-gray-900">Mansi Ganesh Bhise</h3>
                <p class="text-sm/6 font-semibold text-indigo-600">SILAMBAM International Player</p>
                <p class="text-sm/6 font-semibold text-indigo-600">Girl's Instructor</p>
              </div>
            </div>
          </li>
  
        <!-- More people... -->
      </ul>
    </div>
</div>
  