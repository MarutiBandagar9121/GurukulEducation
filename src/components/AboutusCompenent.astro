---
import HomeImage from "../assets/homeImage.png"
import AwardCardComponent from "./AwardCardComponent.astro"
import MeetTheTeamComponent from "./MeetTheTeamComponent.astro"
---


<div class="aboutus-root w-full relative">

    <div class="info flex flex-col lg:flex-row px-8 flex-wrap mt-4">
        <div class="info-text sm:w-full  lg:w-1/2 order-2 lg:order-1 flex justify-center items-center px-3">
            <p class="py-8">
                We envision a future where military personnel 
                are exceptionally prepared to face any 
                challenge with confidence and competence. 
                By providing innovative training solutions, 
                we aim to enhance mission readiness and 
                operational effectiveness across all 
                branches of the military.
            </p>
        </div>
        <div class="info-img sm:w-full lg:w-1/2 flex justify-center order-1 lg:order-2">
            <img src={HomeImage.src} alt="" class="w-72">
        </div>
    </div>

    <div class="about-mission mt-4">
        <div class="flex items-center gap-4 ml-5 mt-5 justify-start">
            <div class="h-px w-20 bg-orange-800"></div>
            <span class="font-extrabold text-orange-800 text-2xl italic">MISSION</span>
